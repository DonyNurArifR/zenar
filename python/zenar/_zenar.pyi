"""Type stubs for the native zenar extension."""

import datetime
from collections.abc import Iterable, Mapping, Sequence
from typing import Any, Literal, TypeAlias, final

import numpy as np

Vector: TypeAlias = Sequence[float] | np.ndarray
Metadata: TypeAlias = Mapping[str, str | int | float | bool | datetime.datetime]
Hit: TypeAlias = dict[str, Any]
Document: TypeAlias = dict[str, Any]

__all__ = [
    "VectorDB",
    "Collection",
    "Filter",
    "Field",
    "FieldNamespace",
    "field",
    "ZenarError",
    "CollectionNotFoundError",
    "CollectionClosedError",
    "CollectionAlreadyExistsError",
    "InvalidCollectionNameError",
    "DimensionMismatchError",
    "DuplicateIdError",
    "VectorNotFoundError",
    "InvalidVectorError",
    "InvalidMetadataError",
    "InvalidFilterError",
    "InvalidArgumentError",
    "DatabaseLockedError",
    "VectorStoreError",
    "MetadataStoreError",
    "PersistenceError",
    "RecoveryError",
]

class ZenarError(Exception): ...
class CollectionNotFoundError(ZenarError): ...
class CollectionClosedError(ZenarError): ...
class CollectionAlreadyExistsError(ZenarError): ...
class InvalidCollectionNameError(ZenarError): ...
class DimensionMismatchError(ZenarError): ...
class DuplicateIdError(ZenarError): ...
class VectorNotFoundError(ZenarError): ...
class InvalidVectorError(ZenarError): ...
class InvalidMetadataError(ZenarError): ...
class InvalidFilterError(ZenarError): ...
class InvalidArgumentError(ZenarError): ...
class DatabaseLockedError(ZenarError): ...
class VectorStoreError(ZenarError): ...
class MetadataStoreError(ZenarError): ...
class PersistenceError(ZenarError): ...
class RecoveryError(ZenarError): ...

@final
class Filter:
    def __and__(self, other: "Filter", /) -> "Filter": ...
    def __rand__(self, other: "Filter", /) -> "Filter": ...
    def __or__(self, other: "Filter", /) -> "Filter": ...
    def __ror__(self, other: "Filter", /) -> "Filter": ...
    def __invert__(self) -> "Filter": ...
    def __bool__(self) -> Literal[False]: ...

@final
class Field:
    def __eq__(self, other: object, /) -> Filter: ...  # type: ignore[override]
    def __ne__(self, other: object, /) -> Filter: ...  # type: ignore[override]
    def __lt__(self, other: Any, /) -> Filter: ...
    def __le__(self, other: Any, /) -> Filter: ...
    def __gt__(self, other: Any, /) -> Filter: ...
    def __ge__(self, other: Any, /) -> Filter: ...
    def isin(self, values: Iterable[Any]) -> Filter: ...

@final
class FieldNamespace:
    def __getattr__(self, name: str) -> Field: ...
    def __call__(self, name: str) -> Field: ...

field: FieldNamespace

@final
class Collection:
    @property
    def name(self) -> str: ...
    @property
    def dimension(self) -> int | None: ...
    @property
    def bit_width(self) -> int: ...
    def add(self, id: int, vector: Vector, text: str, metadata: Metadata | None = None) -> None: ...
    def add_many(self, records: Iterable[Mapping[str, Any]]) -> int: ...
    def get(self, id: int) -> Document | None: ...
    def get_many(self, ids: Sequence[int]) -> list[Document]: ...
    def delete(self, id: int) -> None: ...
    def delete_many(self, ids: Iterable[int]) -> int: ...
    def describe(self, *, scope: Mapping[str, Any] | None) -> dict[str, Any]: ...
    def find_values(
        self, field: str, text: str, limit: int = 20, *, scope: Mapping[str, Any] | None
    ) -> list[dict[str, Any]]: ...
    def retrieve(
        self,
        vector: Vector,
        top_k: int = 10,
        where: Mapping[str, Any] | str | None = None,
        *,
        scope: Mapping[str, Any] | None,
    ) -> dict[str, Any]: ...
    def tool_spec(
        self, name: str, prompt_only: bool = False, *, scope: Mapping[str, Any] | None
    ) -> Any: ...  # ToolSpec, or str when prompt_only
    def count(self) -> int: ...
    def stats(self) -> dict[str, Any]: ...
    def calibrate(self, sample: Vector) -> None: ...
    def search(
        self,
        vector: Vector,
        top_k: int | None = None,
        filter: Filter | None = None,
        **equality: str | int | float | bool | datetime.datetime,
    ) -> list[Hit]: ...

@final
class VectorDB:
    def __new__(cls, path: str, durable: bool = False) -> "VectorDB": ...
    def create_collection(
        self,
        name: str,
        dimension: int | None = None,
        bit_width: Literal[2, 3, 4] | None = None,
    ) -> Collection: ...
    def get_collection(self, name: str) -> Collection: ...
    def list_collections(self) -> list[str]: ...
    def drop_collection(self, name: str) -> None: ...
    def rebuild(self, name: str) -> dict[str, int]: ...
    def recovery_report(self) -> dict[str, int]: ...
    def stats(self) -> dict[str, Any]: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> "VectorDB": ...
    def __exit__(
        self, _exc_type: object = None, _exc: object = None, _tb: object = None
    ) -> Literal[False]: ...

