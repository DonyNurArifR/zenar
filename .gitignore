# Rust
/target/
**/*.rs.bk
*.pdb

# Python / maturin
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
wheels/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Zenar runtime data (created by running examples/tests locally, not source)
*.tv
*.zvec
*.zdocs
*.db
/data/
# The compatibility fixture is a real database, so its files are tracked.
!tests/fixtures/**

# Markdown — ignore all except the public project docs
*.md
!README.md
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!SECURITY.md
!docs/*.md
!.github/**/*.md

# IDE / OS
.DS_Store
.idea/
.vscode/

# Claude Code local settings — must never be committed (see global CLAUDE.md)
.claude/

# Generated knowledge graph (graphify)
graphify-out/

# Compiled extension copied in by `maturin develop`
*.so
*.pyd
*.dylib
docs/_build/
_site/
